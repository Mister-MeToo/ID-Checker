<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>enterUserDetailsServlet</servlet-name>
        <servlet-class>za.ac.tut.web.enterUserDetailsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>logoutServlet</servlet-name>
        <servlet-class>za.ac.tut.web.logoutServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>verifyID</servlet-name>
        <servlet-class>za.ac.tut.web.verifyID</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>viewAllIDs</servlet-name>
        <servlet-class>za.ac.tut.web.viewAllIDs</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>totalIDServlet</servlet-name>
        <servlet-class>za.ac.tut.web.totalIDServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>enterUserDetailsServlet</servlet-name>
        <url-pattern>/enterUserDetailsServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>logoutServlet</servlet-name>
        <url-pattern>/logoutServlet.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>verifyID</servlet-name>
        <url-pattern>/verifyID.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>viewAllIDs</servlet-name>
        <url-pattern>/viewAllIDs.do</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>totalIDServlet</servlet-name>
        <url-pattern>/totalIDServlet.do</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    <error-page>
        <error-code>403</error-code>
        <location>/403.jsp</location>
    </error-page>
    <security-constraint>
        <display-name>ManagerConstraint</display-name>
        <web-resource-collection>
            <web-resource-name>Manager Pages</web-resource-name>
            <description/>
            <url-pattern>/manager.jsp</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>manager</role-name>
        </auth-constraint>
    </security-constraint>
    <security-constraint>
        <display-name>Data_captuterConstraint</display-name>
        <web-resource-collection>
            <web-resource-name>Data_captuter Pages</web-resource-name>
            <description/>
            <url-pattern>/data_captuter.jsp</url-pattern>
        </web-resource-collection>
        <auth-constraint>
            <description/>
            <role-name>data_capturer</role-name>
        </auth-constraint>
    </security-constraint>
    <login-config>
        <auth-method>FORM</auth-method>
        <realm-name>file</realm-name>
        <form-login-config>
            <form-login-page>/login.jsp</form-login-page>
            <form-error-page>/loginError.jsp</form-error-page>
        </form-login-config>
    </login-config>
    <security-role>
        <description/>
        <role-name>manager</role-name>
    </security-role>
    <security-role>
        <description/>
        <role-name>data_capturer</role-name>
    </security-role>
</web-app>
